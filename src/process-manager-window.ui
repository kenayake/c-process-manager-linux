<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="ProcessManagerWindow" parent="GtkApplicationWindow">
    <property name="title" translatable="yes">Process-manager</property>
    <property name="default-width">1128</property>
    <property name="default-height">768</property>
    <property name="titlebar">
      <object class="GtkHeaderBar">
        <property name="title-widget">
          <object class="PmSearchBar" id="search_bar"/>
        </property>
        <property name="decoration-layout">icon:minimize,maximize,close</property>
        <child type="start">
          <object class="GtkBox">
            <property name="spacing">16</property>
            <child>
              <object class="GtkImage">
                <property name="resource">/com/github/kenayake/ProcessManager/images/logo_small.png</property>
                <property name="pixel-size">24</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">Process Manager</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
