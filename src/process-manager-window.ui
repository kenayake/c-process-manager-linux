<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <template class="ProcessManagerWindow" parent="GtkApplicationWindow">
    <property name="title" translatable="yes">Process-manager</property>
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <property name="titlebar">
      <object class="GtkHeaderBar">
        <property name="title-widget">
          <object class="GtkSearchEntry" id="search_bar">

          </object>
        </property>
        <child type="start">
          <object class="GtkLabel">
            <property name="label">Process Manager</property>
          </object>
        </child>
      </object>
    </property>
    <property name="child">
      <object class="GtkLabel" id="label">
        <property name="label" translatable="yes">Hello, World!</property>
        <style>
          <class name="title-1"/>
        </style>
      </object>
    </property>
  </template>
</interface>
